# Environment contract — BEFORE-DESIGN.md §32.3. Copy to .env.local and fill in.
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_PROJECT_ID=
MEDPLUM_AGENT_CLIENT_ID=
MEDPLUM_AGENT_CLIENT_SECRET=
MEDPLUM_CLINICIAN_CLIENT_ID=
MEDPLUM_CLINICIAN_CLIENT_SECRET=
DEEPGRAM_API_KEY=
DEMO_TIMEZONE=America/Los_Angeles
# Set to the hosted app's canonical URL for social link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
ENABLE_MEDPLUM_POLICY_PROOF=false
ENABLE_DEEPGRAM_WORD_CONFIDENCE=false

# Phone leg (optional stretch — browser witness works without these)
VAPI_PRIVATE_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID_SPOUSE=
VAPI_ASSISTANT_ID_DAUGHTER=
PUBLIC_BASE_URL=
VAPI_WEBHOOK_SECRET=
# Outbound requires a BYO Twilio number (Vapi-provided numbers block outbound on PAYG)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Stage-managed second witness: runs Ana's fixture interview server-side when Luis's claim lands
DEMO_AUTOSTAGE_ANA=false
